# --- .env.example ---
GITHUB_PERSONAL_ACCESS_TOKEN=key_goeshere

# --- OPEN ROUTER (Recommended Default) ---
# Recommended default for access to all models with one key.
OPENROUTER_API_KEY=your_openrouter_key_here

# --- ORCHESTRATOR (Gemini) ---
GEMINI_API_KEY=key_goeshere

# --- WORKER (Claude) ---
ANTHROPIC_API_KEY=key_goeshere

# --- AUDITOR (OpenAI) ---
OPENAI_API_KEY=your_openai_key_here

# --- TOOLS & MCP SERVERS ---
BRAVE_API_KEY=your_brave_search_key_here

# --- OCCIPITAL LOBE (Visual Cortex) ---
VISION_MODEL="gpt-4o-mini"

# --- CORPUS CALLOSUM (Local SLM Bridging) ---
# This requires Ollama running locally (http://localhost:11434).
USE_LOCAL_SLM=false
LOCAL_MODEL_NAME=ollama/llama3

# Deployment Credentials
DEPLOYMENT_TOKEN=replace_with_your_provider_token

# [SECURITY OPT-IN]
# Set to 'true' to allow autonomous execution of shell commands, scripts, and containers.
# Leave false to run CoreTex OS in read-only advisory mode (Safe-by-Default).
CORETEX_ENABLE_CODE_EXECUTION=false

LITELLM_LOG="ERROR"

# --- BROKER / AI GATEWAY (Optional Security Layer) ---
# Use this to route traffic through Cloudflare AI Gateway, Portkey, etc.
GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1/ACCOUNT_TAG/GATEWAY/
GATEWAY_API_KEY=your_proxy_token_here
