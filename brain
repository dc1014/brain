#!/bin/bash
# ⚡ ZERO-DEBT: Unix Spinal Cord with Absolute Path Virtualization
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

# Check if the user built the Docker sandbox containment loop
if command -v docker &> /dev/null && docker image inspect brain-os &> /dev/null; then
    # 🛡️ HARDENING: Explicitly calculate and export runtime environment variables.
    export UID=$(id -u)
    export GID=$(id -g)

    # ⚡ FIXED: Natively build fallback directory to preserve host user ownership boundaries
    export BRAIN_WORKSPACE_MOUNT="$(pwd)/Workspace"
    mkdir -p "$BRAIN_WORKSPACE_MOUNT"

    # Scan positional arguments to locate, absolute-resolve, and container-map paths
    ARGS=()
    for arg in "$@"; do
        if [[ -e "$arg" ]]; then
            # Convert the relative host asset path safely to an absolute path string
            ABS_PATH="$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")"
            export BRAIN_WORKSPACE_MOUNT="$ABS_PATH"

            # Rewrite the parameter route so the container processes the file under its /workspace layer
            ARGS+=("/workspace")
        else
            ARGS+=("$arg")
        fi
    done

    exec docker compose run --rm brain "${ARGS[@]}"
fi

# Fallback route directly to the lightning-fast local virtual environment
exec ./.venv/bin/python -m System.cli "$@"
