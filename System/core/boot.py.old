import os
import sys
import re
import json
import shutil
import asyncio
import urllib.request
import urllib.error
from pathlib import Path
from typing import Dict, List, Tuple, Any, Optional
from rich.console import Console
from rich.panel import Panel
from rich.table import Table
from rich.prompt import Prompt, Confirm
from rich.progress import Progress, SpinnerColumn, TextColumn
from System.core.paths import ROOT_DIR

console = Console()

KEY_PATTERNS: Dict[str, str] = {
    "OPENAI_API_KEY": r"^(sk-[a-zA-Z0-9]{48}|sk-proj-[a-zA-Z0-9_-]+)$",
    "ANTHROPIC_API_KEY": r"^sk-ant-[a-zA-Z0-9_-]{95,}$",
    "GEMINI_API_KEY": r"^AIzaSy[a-zA-Z0-9_-]{33}$",
    "OPENROUTER_API_KEY": r"^sk-or-v1-[a-zA-Z0-9_-]{64}$",
}


# --- SEGMENT 1: ATOMIC I/O UTILITIES (SHIFT-LEFT PROTECTION) ---


def _atomic_write_text(target_path: Path, text_content: str) -> None:
    """🛡️ SHIFT-LEFT DEFENSE: Guarantees zero partial file corruption via atomic .tmp swap blocks."""
    tmp_path = target_path.with_suffix(".tmp")
    tmp_path.write_text(text_content, encoding="utf-8")
    shutil.move(str(tmp_path), str(target_path))


def _atomic_write_json(target_path: Path, data: Any) -> None:
    """🛡️ SHIFT-LEFT DEFENSE: Safely serializes and atomic-swaps JSON structural files."""
    _atomic_write_text(target_path, json.dumps(data, indent=2, ensure_ascii=False))


# --- SEGMENT 2: HOST DIAGNOSTICS & INFRASTRUCTURE ---


async def validate_key_live(key_name: str, key_val: str) -> Tuple[bool, str]:
    """Runs a non-billing metadata probe to verify if an API token is active."""
    if not key_val:
        return False, "Empty key credential trace found."
    try:
        url = ""
        headers: Dict[str, str] = {}
        if key_name == "OPENAI_API_KEY":
            url = "https://api.openai.com/v1/models"
            headers = {"Authorization": f"Bearer {key_val}"}
        elif key_name == "ANTHROPIC_API_KEY":
            url = "https://api.anthropic.com/v1/models"
            headers = {"x-api-key": key_val, "anthropic-version": "2023-06-01"}
        elif key_name == "GEMINI_API_KEY":
            url = (
                f"https://generativelanguage.googleapis.com/v1beta/models?key={key_val}"
            )
        elif key_name == "OPENROUTER_API_KEY":
            url = "https://openrouter.ai/api/v1/models"
            headers = {"Authorization": f"Bearer {key_val}"}
        else:
            return True, "Structure format confirmed."

        req = urllib.request.Request(url, headers=headers, method="GET")

        def run_probe() -> None:
            with urllib.request.urlopen(req, timeout=3.0) as res:
                res.read()

        await asyncio.to_thread(run_probe)
        return True, "API Handshake Successful: Key is live and authorized."
    except urllib.error.HTTPError as e:
        if e.code in [401, 403]:
            return (
                False,
                f"Handshake Refused (HTTP {e.code}): Authentication Rejected. Key is invalid or revoked.",
            )
        return True, f"Server acknowledged payload (HTTP {e.code}), key accepted."
    except Exception as ex:
        return (
            True,
            f"Network timeout or bypass ({str(ex)}). Format validation approved.",
        )


async def check_host_binary(binary_name: str) -> bool:
    """Verifies if a specific utility binary is available in the host path shell environment."""
    try:

        def find_binary() -> Optional[str]:
            return shutil.which(binary_name)

        res = await asyncio.to_thread(find_binary)
        return res is not None
    except Exception:
        return False


async def scan_ollama() -> Tuple[bool, List[str]]:
    """Checks if the local Ollama daemon is running and lists available models."""
    try:
        req = urllib.request.Request("http://localhost:11434/api/tags", method="GET")

        def fetch() -> bytes:
            with urllib.request.urlopen(req, timeout=1.5) as response:
                return response.read()

        raw_data = await asyncio.to_thread(fetch)
        data = json.loads(raw_data.decode("utf-8"))
        models = [m["name"] for m in data.get("models", [])]
        return True, models
    except Exception:
        return False, []


# --- SEGMENT 3: SYSTEM CONFIGURATION CALIBRATION ---


def ensure_membranes_exist() -> None:
    """Scaffolds all structural folders needed for system operations."""
    target_dirs = [
        "Studio",
        "Personal",
        "Professional",
        "Meta",
        "Sense",
        "System/tools/engrams",
        "System/logs",
    ]
    for d in target_dirs:
        p = ROOT_DIR / d
        if not p.exists():
            p.mkdir(parents=True, exist_ok=True)
            console.print(
                f"   ✨ [green]Formed membrane partition:[/green] [dim]{d}[/dim]"
            )


def calibrate_model_dna(active_keys: List[str]) -> bool:
    """🧬 AUTOMATED CALIBRATION: Safely adjusts models.yaml to match active tokens using multi-line anchors."""
    yaml_path = ROOT_DIR / "System" / "config" / "models.yaml"
    if not yaml_path.exists():
        return False
    try:
        content = yaml_path.read_text(encoding="utf-8")
        provider_target = "openai"
        if "GEMINI_API_KEY" in active_keys and len(active_keys) == 1:
            provider_target = "gemini"
        elif "ANTHROPIC_API_KEY" in active_keys and len(active_keys) == 1:
            provider_target = "anthropic"

        # ⚡ THE LINE FIX: Use MULTILINE flags with strict indentation anchors to protect trailing sub-comments
        if provider_target == "gemini":
            content = re.sub(
                r"^  fast:\s*['\"].*?['\"]",
                "  fast: 'gemini/gemini-2.5-flash'",
                content,
                flags=re.MULTILINE,
            )
            content = re.sub(
                r"^  premium:\s*['\"].*?['\"]",
                "  premium: 'gemini/gemini-2.5-pro'",
                content,
                flags=re.MULTILINE,
            )
            content = re.sub(
                r"^  default:\s*['\"].*?['\"]",
                "  default: 'gemini/gemini-2.5-flash'",
                content,
                flags=re.MULTILINE,
            )
        elif provider_target == "anthropic":
            content = re.sub(
                r"^  fast:\s*['\"].*?['\"]",
                "  fast: 'anthropic/claude-3-5-haiku'",
                content,
                flags=re.MULTILINE,
            )
            content = re.sub(
                r"^  premium:\s*['\"].*?['\"]",
                "  premium: 'anthropic/claude-3-5-sonnet'",
                content,
                flags=re.MULTILINE,
            )
            content = re.sub(
                r"^  default:\s*['\"].*?['\"]",
                "  default: 'anthropic/claude-3-5-sonnet'",
                content,
                flags=re.MULTILINE,
            )
        else:
            content = re.sub(
                r"^  fast:\s*['\"].*?['\"]",
                "  fast: 'openai/gpt-4o-mini'",
                content,
                flags=re.MULTILINE,
            )
            content = re.sub(
                r"^  premium:\s*['\"].*?['\"]",
                "  premium: 'openai/gpt-4o'",
                content,
                flags=re.MULTILINE,
            )
            content = re.sub(
                r"^  default:\s*['\"].*?['\"]",
                "  default: 'openai/gpt-4o-mini'",
                content,
                flags=re.MULTILINE,
            )

        _atomic_write_text(yaml_path, content)
        return True
    except Exception:
        return False


# --- SEGMENT 4: EXOCORTEX (OBSIDIAN) SYNAPTIC BINDING ---


async def sniff_obsidian_vaults() -> List[Path]:
    """Scans system app metadata paths to locate existing local Obsidian vaults."""
    vault_paths: List[Path] = []
    config_file: Optional[Path] = None
    if sys.platform == "win32":
        appdata = os.environ.get("APPDATA", "")
        if appdata:
            config_file = Path(appdata) / "obsidian" / "obsidian.json"
    elif sys.platform == "darwin":
        config_file = Path(
            os.path.expanduser("~/Library/Application Support/obsidian/obsidian.json")
        )
    else:
        config_file = Path(os.path.expanduser("~/.config/obsidian/obsidian.json"))

    if config_file and config_file.exists():
        try:

            def read_vault_config() -> str:
                return config_file.read_text(encoding="utf-8")

            raw_text = await asyncio.to_thread(read_vault_config)
            data = json.loads(raw_text)
            for _, vault_meta in data.get("vaults", {}).items():
                p = Path(vault_meta.get("path", ""))
                if p.exists():
                    vault_paths.append(p)
        except Exception:
            pass
    return vault_paths


def setup_obsidian_shell_commands(vault_path: Path) -> bool:
    """Pre-populates Brain OS commands, binds global hotkeys, and auto-activates plugins safely and non-destructively."""
    obsidian_dir = vault_path / ".obsidian"
    plugins_dir = obsidian_dir / "plugins"
    sc_dir = plugins_dir / "obsidian-shellcommands"
    sc_dir.mkdir(parents=True, exist_ok=True)

    sc_config_file = sc_dir / "data.json"
    manifest_file = sc_dir / "manifest.json"
    community_plugins_file = obsidian_dir / "community-plugins.json"
    app_config_file = obsidian_dir / "app.json"
    hotkeys_file = obsidian_dir / "hotkeys.json"

    if not manifest_file.exists():
        manifest_data = {
            "id": "obsidian-shellcommands",
            "name": "Shell Commands",
            "version": "0.19.0",
            "minAppVersion": "0.12.0",
            "description": "Execute terminal commands from Obsidian.",
            "author": "Tero Karvinen",
            "isDesktopOnly": True,
        }
        _atomic_write_json(manifest_file, manifest_data)

    brain_cli_path = (ROOT_DIR / "System" / "cli.py").as_posix()
    brain_commands = [
        {
            "id": "brain-status",
            "name": "🧠 Brain OS: Check Vitals",
            "inputMethod": "execute-command",
            "command": f'uv run python "{brain_cli_path}" status',
            "outputMethod": "output-channel",
        },
        {
            "id": "brain-sleep",
            "name": "🌙 Brain OS: Enter Deep Sleep",
            "inputMethod": "execute-command",
            "command": f'uv run python "{brain_cli_path}" sleep',
            "outputMethod": "output-channel",
        },
        {
            "id": "brain-daydream",
            "name": "🌌 Brain OS: Trigger Daydream",
            "inputMethod": "execute-command",
            "command": f'uv run python "{brain_cli_path}" daydream',
            "outputMethod": "output-channel",
        },
    ]

    try:
        # ⚡ THE NON-DESTRUCTIVE MERGE FIX: Safely preserve existing commands inside plugin data.json
        existing_config: Dict[str, Any] = {}
        if sc_config_file.exists():
            try:
                existing_config = json.loads(sc_config_file.read_text(encoding="utf-8"))
            except Exception:
                pass

        if "settings" not in existing_config:
            existing_config["settings"] = {}
        if "commands" not in existing_config["settings"]:
            existing_config["settings"]["commands"] = []

        current_cmds = existing_config["settings"]["commands"]
        existing_ids = {c.get("id") for c in current_cmds if isinstance(c, dict)}

        for cmd in brain_commands:
            if cmd["id"] not in existing_ids:
                current_cmds.append(cmd)

        _atomic_write_json(sc_config_file, existing_config)

        # 2. Append plugin to active list
        current_plugins: List[str] = []
        if community_plugins_file.exists():
            try:
                current_plugins = json.loads(
                    community_plugins_file.read_text(encoding="utf-8")
                )
            except Exception:
                pass
        if "obsidian-shellcommands" not in current_plugins:
            current_plugins.append("obsidian-shellcommands")
            _atomic_write_json(community_plugins_file, current_plugins)

        app_config: Dict[str, Any] = {}
        if app_config_file.exists():
            try:
                app_config = json.loads(app_config_file.read_text(encoding="utf-8"))
            except Exception:
                pass
        app_config["legacyCommunityPlugins"] = False
        _atomic_write_json(app_config_file, app_config)

        hotkeys_config: Dict[str, Any] = {}
        if hotkeys_file.exists():
            try:
                hotkeys_config = json.loads(hotkeys_file.read_text(encoding="utf-8"))
            except Exception:
                pass

        hotkeys_config["obsidian-shellcommands:brain-status"] = [
            {"modifiers": ["Ctrl", "Alt"], "key": "S"}
        ]
        hotkeys_config["obsidian-shellcommands:brain-sleep"] = [
            {"modifiers": ["Ctrl", "Alt"], "key": "L"}
        ]
        _atomic_write_json(hotkeys_file, hotkeys_config)

        return True
    except Exception:
        return False


# --- SEGMENT 5: APPARATUS ENTRY POINTS & LIFECYCLE ---


def bootstrap() -> bool:
    """Global configuration loading hook executed on every single CLI loop interaction execution entry point."""
    try:
        env_file = ROOT_DIR / ".env"
        if env_file.exists():
            for line in env_file.read_text(encoding="utf-8").splitlines():
                if "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    os.environ[k.strip()] = v.strip()

        from System.neuroanatomy.systemic.immune_system import vault

        vault.secure_environment()

        target_dirs = [
            "Studio",
            "Personal",
            "Professional",
            "Meta",
            "Sense",
            "System/tools/engrams",
            "System/logs",
        ]
        for d in target_dirs:
            (ROOT_DIR / d).mkdir(parents=True, exist_ok=True)

        return True
    except Exception as e:
        print(
            f"Catastrophic Operating System Bootstrap Rejection: {e}", file=sys.stderr
        )
        return False


async def harvest_credentials() -> Dict[str, str]:
    """Interactively gathers, masks, and tests provider API tokens."""
    console.print(
        "\n[bold cyan]🔑 Phase 3: Token Inoculation & Pre-Flight Handshakes[/bold cyan]"
    )
    console.print(
        "[dim]Provide at least one key. Input is masked to protect tokens from screen sniffer leaks.[/dim]\n"
    )

    collected_keys: Dict[str, str] = {}
    env_file = ROOT_DIR / ".env"
    existing_env: Dict[str, str] = {}

    if env_file.exists():
        for line in env_file.read_text(encoding="utf-8").splitlines():
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                existing_env[k.strip()] = v.strip()

    for key_name, regex_pattern in KEY_PATTERNS.items():
        existing_val = existing_env.get(key_name, "")
        prompt_msg = f"Enter {key_name}"
        if existing_val:
            prompt_msg += (
                f" [dim](Current: {existing_val[:6]}...{existing_val[-4:]})[/dim]"
            )

        while True:
            user_input = Prompt.ask(
                prompt_msg,
                default=existing_val,
                show_default=False,
                password=True,
                console=console,
            ).strip()
            if not user_input:
                break

            if re.match(regex_pattern, user_input):
                console.print(
                    f"   [dim magenta]🔄 Testing authentication lease handshake for {key_name}...[/dim magenta]"
                )
                live_ok, live_msg = await validate_key_live(key_name, user_input)
                if live_ok:
                    console.print(f"   [bold green]✅ {live_msg}[/bold green]")
                    collected_keys[key_name] = user_input
                    break
                else:
                    console.print(f"   [bold red]🛑 {live_msg}[/bold red]")
                    if Confirm.ask(
                        "   Force override and accept this key anyway?",
                        default=False,
                        console=console,
                    ):
                        collected_keys[key_name] = user_input
                        break
            else:
                console.print(
                    f"[bold red]❌ Invalid regex signature structure for {key_name}. Please re-verify.[/bold red]"
                )

    merged_env = {**existing_env, **collected_keys}
    env_payload = "\n".join([f"{k}={v}" for k, v in merged_env.items()])
    _atomic_write_text(env_file, env_payload + "\n")

    if sys.platform != "win32":
        try:
            os.chmod(env_file, 0o600)
        except Exception:
            pass
    return merged_env


async def setup_wizard() -> None:
    """The Interactive Setup Wizard designed to guide and reward users during onboarding."""
    console.clear()
    console.print(
        Panel.fit(
            "[bold magenta]🧠 BRAIN OS: AUTONOMIC NERVOUS SYSTEM ONBOARDING[/bold magenta]\n"
            "[dim magenta]Initiating Synaptic Genesis Sequence...[/dim magenta]",
            border_style="magenta",
        )
    )

    ollama_live: bool = False
    ollama_models: List[str] = []
    obsidian_vaults: List[Path] = []
    has_git: bool = False
    has_docker: bool = False
    has_node: bool = False

    with Progress(
        SpinnerColumn(),
        TextColumn("[progress.description]{task.description}"),
        console=console,
    ) as progress:
        t1 = progress.add_task(
            "[cyan]Probing local inference pathways (Ollama)...[/cyan]", total=1
        )
        t2 = progress.add_task(
            "[cyan]Sniffing exocortex interfaces (Obsidian)...[/cyan]", total=1
        )
        t3 = progress.add_task(
            "[cyan]Auditing host utility dependencies...[/cyan]", total=1
        )

        results = await asyncio.gather(
            scan_ollama(),
            sniff_obsidian_vaults(),
            check_host_binary("git"),
            check_host_binary("docker"),
            check_host_binary("node"),
        )
        ollama_live, ollama_models = results[0]
        obsidian_vaults = results[1]
        has_git, has_docker, has_node = results[2], results[3], results[4]

        progress.update(t1, completed=1)
        progress.update(t2, completed=1)
        progress.update(t3, completed=1)

    infra_table = Table(title="Host Infrastructure Analysis", border_style="dim yellow")
    infra_table.add_column("Subsystem / Core Driver", style="bold white")
    infra_table.add_column("Status", style="bold")
    infra_table.add_column("Details / Capabilities Assumed", style="dim cyan")
    infra_table.add_row(
        "Git SCM",
        "[green]ONLINE[/green]" if has_git else "[red]ABSENT[/red]",
        "Required for active code forge operations."
        if has_git
        else "Critical: Code modification loops will degrade.",
    )
    infra_table.add_row(
        "Docker Runtime",
        "[green]ONLINE[/green]" if has_docker else "[yellow]SKIPPED[/yellow]",
        "Tier 1 Hardware Sandbox Isolation active."
        if has_docker
        else "Warning: Falling back to Tier 0 Native restrictions.",
    )
    infra_table.add_row(
        "Node.js Runtime",
        "[green]ONLINE[/green]" if has_node else "[dim]ABSENT[/dim]",
        "Allows native workspace local builds."
        if has_node
        else "Local compilation tasks will require sandbox virtualization.",
    )
    infra_table.add_row(
        "Ollama Local Engine",
        "[green]ONLINE[/green]" if ollama_live else "[dim]OFFLINE[/dim]",
        f"Models: {', '.join(ollama_models)}"
        if ollama_live
        else "Using provider cloud fallbacks exclusively.",
    )
    infra_table.add_row(
        "Obsidian Interface",
        "[green]FOUND[/green]" if obsidian_vaults else "[dim]UNMAPPED[/dim]",
        f"Detected {len(obsidian_vaults)} open exocortex paths."
        if obsidian_vaults
        else "No active local note vaults auto-detected.",
    )
    console.print(infra_table)

    if not has_docker:
        console.print(
            Panel(
                "[bold yellow]⚠️  HARDWARE ISOLATION WARNING[/bold yellow]\n\n"
                "Docker is missing or not running. Brain OS will fallback to [bold]Tier 0 Native Execution Plane[/bold].\n"
                "To unlock zero-trust package sandboxing and outbound egress network proxy firewalls,\n"
                "please spin up Docker Desktop: [cyan]https://docs.docker.com/engine/install/[/cyan]",
                border_style="yellow",
            )
        )

    console.print(
        "\n[bold cyan]🧬 Phase 2: Structural Membrane Inoculation[/bold cyan]"
    )
    ensure_membranes_exist()
    console.print(
        "   [bold green]✅ Architectural layout membranes secured.[/bold green]"
    )

    merged_env = await harvest_credentials()
    active_tokens = [k for k, v in merged_env.items() if v]
    if calibrate_model_dna(active_tokens):
        console.print(
            "   [bold green]🧬 Brain OS Model routing tables auto-calibrated to matching live keys.[/bold green]"
        )

    console.print(
        "\n[bold cyan]🖥️  Phase 4: Exocortex Plugin Inoculation & Auto-Activation[/bold cyan]"
    )
    selected_vault: Optional[Path] = None
    if obsidian_vaults:
        console.print("   Discovered existing Obsidian vaults:")
        for idx, path in enumerate(obsidian_vaults):
            console.print(f"    [{idx}] {path}")
        if Confirm.ask(
            "   Would you like to auto-wire and activate Brain OS commands in one of these vaults?",
            default=True,
            console=console,
        ):
            choice = Prompt.ask(
                "   Select vault index",
                choices=[str(i) for i in range(len(obsidian_vaults))],
                default="0",
                console=console,
            )
            selected_vault = obsidian_vaults[int(choice)]
    else:
        custom_path_str = Prompt.ask(
            "   No vaults found. Enter custom Obsidian Vault absolute path (or press Enter to skip)",
            default="",
            console=console,
        ).strip()
        if custom_path_str:
            selected_vault = Path(custom_path_str)

    if selected_vault and selected_vault.exists():
        if setup_obsidian_shell_commands(selected_vault):
            console.print(
                "   [bold green]✅ Brain OS controls & hotkeys ([cyan]Ctrl+Alt+S[/cyan]) auto-enabled in Obsidian![/bold green]"
            )
        else:
            console.print(
                "   [red]🛑 Failed to auto-configure vault plugin paths.[/red]"
            )

    final_panel_msg = (
        "[bold green]✨ SYNAPTIC GENESIS SHIPPED SUCCESSFULLY[/bold green]\n\n"
        "Brain OS environment membranes are sealed, secure, and cross-compiled.\n\n"
        "Launch your conscious autonomic operating system daemon loop via:\n"
        "[bold cyan]uv run python System/cli.py live[/bold cyan]"
    )
    console.print(Panel(final_panel_msg, border_style="magenta"))
