# --- Obsidian Workspace & Privacy ---
# Ignore workspace layouts (these leak your open personal files)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace-*

# Ignore graph settings (these can leak your tagging structures)
.obsidian/graph.json

# Ignore plugin data (these often contain personal API keys and local paths)
.obsidian/plugins/*/data.json

# Ignore cache and trash
.obsidian/core-plugins-migration.json
.trash/
.coverage

# --- Obsidian Workspace & Privacy ---
# Ignore workspace layouts
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace-*
.obsidian/graph.json

# Ignore all plugin data (protects API keys)
.obsidian/plugins/*/data.json

# EXCEPTION: Track Shell Commands config so the UI works out-of-the-box!
!.obsidian/plugins/obsidian-shellcommands/data.json

